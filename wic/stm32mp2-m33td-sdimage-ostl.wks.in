# short-description: Create SD card image with a boot partition
# long-description: Creates a partitioned SD card image for STM32MP1 OpenSTLinux BSP
#
#  - -------- ----- ------------ -------- ---------- -------- --------
# | | TFA(2) | FIP | U-BOOT ENV | bootfs | vendorfs | rootfs | userfs |
#  - -------- ----- ------------ -------- ---------- -------- --------
# ^ ^
# | |
# 0 17kB
#
# Partition sizes are defined throught the machine settings (or can be changed manually on this file).
#
# Warning: the first stage of boot (here fsbl1, fsbl2, fip) MUST be on GPT partition to be detected.
#

# FSBL partitions (TF-M BL2)
part ${STM32MP_FSBLM1_NAME} --source rawcopy --fstype=ext4 --fsoptions "noauto" --part-name=${STM32MP_FSBLM1_NAME} --sourceparams="file=${DEPLOY_DIR_IMAGE}/arm-trusted-firmware-m/bl2/bl2-${BOOTLOADER_EXTERNAL_DT}-sdcard.stm32" --ondisk mmcblk --part-type 0x8301 --fixed-size ${STM32MP_FSBLM1_SIZE}K --align 17
part ${STM32MP_FSBLM2_NAME} --source rawcopy --fstype=ext4 --fsoptions "noauto" --part-name=${STM32MP_FSBLM2_NAME} --sourceparams="file=${DEPLOY_DIR_IMAGE}/arm-trusted-firmware-m/bl2/bl2-${BOOTLOADER_EXTERNAL_DT}-sdcard.stm32" --ondisk mmcblk --part-type 0x8301 --fixed-size ${STM32MP_FSBLM2_SIZE}K

# M33DDR partitions
part ${STM32MP_M33DDRA_NAME} --source rawcopy --fstype=ext4 --fsoptions "noauto" --part-name=${STM32MP_M33DDRA_NAME} --sourceparams="file=${DEPLOY_DIR_IMAGE}/m33-firmware/ddr_phy-${BOOTLOADER_EXTERNAL_DT}-sdcard_Signed.bin" --ondisk mmcblk --part-type 0x8301 --fixed-size ${STM32MP_M33DDRA_SIZE}K --align 17
part ${STM32MP_M33DDRB_NAME} --source empty --fstype=ext4 --fsoptions "noauto" --part-name=${STM32MP_M33DDRB_NAME} --ondisk mmcblk --part-type 0x8301 --fixed-size ${STM32MP_M33DDRB_SIZE}K

# M33FW partitions
part ${STM32MP_M33FWA_NAME} --source rawcopy --fstype=ext4 --fsoptions "noauto" --part-name=${STM32MP_M33FWA_NAME} --sourceparams="file=${DEPLOY_DIR_IMAGE}/m33-firmware/tfm-StarterApp_M33TD-${BOOTLOADER_EXTERNAL_DT}-sdcard-sdcard_s_ns_Signed.bin" --ondisk mmcblk --part-type 0x8301 --fixed-size ${STM32MP_M33FWA_SIZE}K --align 17
part ${STM32MP_M33FWB_NAME} --source empty --fstype=ext4 --fsoptions "noauto" --part-name=${STM32MP_M33FWB_NAME} --ondisk mmcblk --part-type 0x8301 --fixed-size ${STM32MP_M33FWB_SIZE}K

# FSBL partitions (TF-A BL2)
part ${STM32MP_FSBL1_NAME} --source rawcopy --fstype=ext4 --fsoptions "noauto" --part-name=${STM32MP_FSBL1_NAME} --sourceparams="file=${DEPLOY_DIR_IMAGE}/arm-trusted-firmware/tf-a-${BOOTLOADER_EXTERNAL_DT}-${BOOTSCHEME}-sdcard.stm32" --ondisk mmcblk --part-type 0x8301 --fixed-size ${STM32MP_FSBL1_SIZE}K --align 17
part ${STM32MP_FSBL2_NAME} --source rawcopy --fstype=ext4 --fsoptions "noauto" --part-name=${STM32MP_FSBL2_NAME} --sourceparams="file=${DEPLOY_DIR_IMAGE}/arm-trusted-firmware/tf-a-${BOOTLOADER_EXTERNAL_DT}-${BOOTSCHEME}-sdcard.stm32" --ondisk mmcblk --part-type 0x8301 --fixed-size ${STM32MP_FSBL2_SIZE}K

# Fip partition
part fip   --source rawcopy --fstype=ext4 --fsoptions "noauto" --part-name=fip --sourceparams="file=${DEPLOY_DIR_IMAGE}/fip/fip-${BOOTLOADER_EXTERNAL_DT}-${BOOTSCHEME}-sdcard.bin" --ondisk mmcblk --part-type 0x8301 --fixed-size ${STM32MP_SSBL1_SIZE}K

# U-BOOT env
part u-boot-env --source empty --part-name=u-boot-env --ondisk mmcblk --part-type 0x8301 --fixed-size ${STM32MP_UENV_SIZE}K

# Bootfs
part /boot --source rootfs --rootfs-dir=${IMAGE_ROOTFS}/boot --ondisk mmcblk --fstype=ext4 --part-name bootfs --active --fixed-size ${STM32MP_BOOTFS_SIZE}K
# Vendorfs
part /vendor --source rootfs --rootfs-dir=${IMAGE_ROOTFS}/vendor --ondisk mmcblk --fstype=ext4 --part-name vendorfs --fixed-size ${STM32MP_VENDORFS_SIZE}K
# Rootfs
part / --source rootfs --ondisk mmcblk --fstype=ext4 --part-name rootfs --extra-space 1024M --uuid ${DEVICE_PARTUUID_ROOTFS:SDCARD}
# Userfs
part /usr/local --source rootfs --rootfs-dir=${IMAGE_ROOTFS}/usr/local --ondisk mmcblk --fstype=ext4 --part-name userfs --fixed-size ${STM32MP_USERFS_SIZE}K

bootloader --ptable gpt
